{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "site-by-site-christianrotzoll-com",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "not_found_handling": "none",
    "run_worker_first": false,
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "routes": [
    {
      "pattern": "site-by-site.christianrotzoll.com",
      "custom_domain": true,
    },
  ],
  "env": {
    "preview": {
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
    },
  },
}
