{
  "name": "site-by-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit && vite build && NODE_ENV=test remix test",
    "dev": "NODE_ENV=development node --watch-path=app --watch-path=public --watch-path=server.ts --watch-path=vite.config.ts --import remix/node-tsx server.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "vite build && NODE_ENV=test remix test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "idb": "^8.0.3",
    "remix": "3.0.0-beta.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "fake-indexeddb": "^6.2.5",
    "playwright": "1.60.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  }
}
