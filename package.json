{
  "name": "site-by-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:preview": "CLOUDFLARE_ENV=preview vite build",
    "check": "pnpm run fmt:check && pnpm run lint && tsc --noEmit && vite build && NODE_ENV=test remix test && NODE_ENV=development remix test",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:preview": "pnpm run build:preview && wrangler deploy",
    "dev": "NODE_ENV=development node --watch-path=app --watch-path=public --watch-path=server.ts --watch-path=vite.config.ts --import remix/node-tsx server.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings",
    "preview": "pnpm run build:preview && vite preview",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "vite build && NODE_ENV=test remix test && NODE_ENV=development remix test",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --include-runtime=false"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "remix": "3.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.8",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "wrangler": "^4.159.0"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "packageManager": "pnpm@12.9.1"
}
