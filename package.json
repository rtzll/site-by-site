{
  "name": "site-by-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:preview": "CLOUDFLARE_ENV=preview vite build",
    "check": "tsc --noEmit && vite build && NODE_ENV=test remix test && NODE_ENV=development remix test",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:preview": "pnpm run build:preview && wrangler deploy",
    "dev": "NODE_ENV=development node --watch-path=app --watch-path=public --watch-path=server.ts --watch-path=vite.config.ts --import remix/node-tsx server.ts",
    "preview": "pnpm run build:preview && vite preview",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "vite build && NODE_ENV=test remix test && NODE_ENV=development remix test",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --include-runtime=false"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "packageManager": "pnpm@12.6.0",
  "dependencies": {
    "idb": "^8.0.3",
    "remix": "3.0.0-rc.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.58.0",
    "@types/node": "^26.6.2",
    "fake-indexeddb": "^6.2.5",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.137.0"
  }
}
